          gift: ['Your magical gift will appear here.', ['Magical gift', 'Ancient treasure']],
          virtue: ['Your greatest strength will appear here.', ['Courage', 'Wisdom']]
        };
        Object.entries(defaults).forEach(([key, [prompt, labels]]) => {
          const question = mythQuestions.find((item) => item.dataset.mythQuestion === key);
          question.disabled = true;
          question.querySelector('.myth-question__prompt').textContent = prompt;
          question.querySelectorAll('[data-myth-answer]').forEach((button, index) => {
            button.textContent = labels[index];
            button.classList.remove('is-selected');
            button.setAttribute('aria-pressed', 'false');
