---
import '@fontsource-variable/cormorant/wght.css';
import '@fontsource-variable/cormorant/wght-italic.css';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/global.css';

const pinterestQuotes = [
  {
    board: 'dream',
    text: "It's about who stands in the rain with you when they also have a choice to be dry. Remember that.",
    pin: '453808099976868561'
  },
  {
    board: 'dream',
    text: 'We romanticize the stars, but forget the dark is what made them visible.',
    pin: '453808099976868589'
  },
  {
    board: 'dream',
    text: 'I asked God for flowers and He gave me rain. When you understand this, everything starts to make sense.',
    pin: '453808099976868590'
  },
  {
    board: 'dream',
    text: 'Dead people receive more flowers than the living ones because regret is stronger than gratitude.',
    credit: 'Anne Frank, as pinned',
    pin: '453808099976868592'
  },
  {
    board: 'dream',
    text: "You can be the prettiest rose ever, but if they like lilies, it wouldn't matter.",
    pin: '453808099976868602'
  },
  {
    board: 'dream',
    text: 'You say you love rain but you open your umbrella. You say you love the sun but you find a shadow spot. You say you love wind but you close your windows. This is why I am afraid when you say you love me.',
    credit: 'William Shakespeare, as pinned',
    pin: '453808099976913740'
  },
  {
    board: 'dream',
    text: 'The day a blind man sees, the first thing he throws away is the stick that has helped him all his life.',
    credit: 'Unknown, as pinned',
    pin: '453808099976868586'
  },
  {
    board: 'dream',
    text: 'Be careful who you trust. Salt and sugar look the same.',
    pin: '453808099976868605'
  },
  {
    board: 'dream',
    text: "Don't set yourself on fire to keep others warm.",
    pin: '453808099976868607'
  },
  {
    board: 'dream',
    text: "Sometimes the grass is greener because it's fake.",
    credit: 'Lindsey Lee and Co., as pinned',
    pin: '453808099976868610'
  },
  {
    board: 'dream',
    text: 'The villain will always be the villain if the hero tells the story.',
    credit: 'Unknown, as pinned',
    pin: '453808099976868629'
  },
  {
    board: 'dream',
    text: "Who betrays you once will betray you a thousand times. There's no need to drink the whole sea to realize it's salty.",
    credit: 'Popular saying, as pinned',
    pin: '453808099976882248'
  }
];

const greekLetters = [
  ['Α', 'Alpha'], ['Β', 'Beta'], ['Γ', 'Gamma'], ['Δ', 'Delta'],
  ['Ε', 'Epsilon'], ['Ζ', 'Zeta'], ['Η', 'Eta'], ['Θ', 'Theta'],
  ['Ι', 'Iota'], ['Κ', 'Kappa'], ['Λ', 'Lambda'], ['Μ', 'Mu'],
  ['Ν', 'Nu'], ['Ξ', 'Xi'], ['Ο', 'Omicron'], ['Π', 'Pi'],
  ['Ρ', 'Rho'], ['Σ', 'Sigma'], ['Τ', 'Tau'], ['Υ', 'Upsilon'],
  ['Φ', 'Phi'], ['Χ', 'Chi'], ['Ψ', 'Psi'], ['Ω', 'Omega']
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Dori — Diary · Photo · Library</title>
    <meta name="description" content="Dori's magical world of favorite words, cinematic photos, and beloved books." />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#06080d" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Dori — A little world of my own" />
    <meta property="og:description" content="Favorite words, cinematic photos, and beloved books." />
    <meta property="og:url" content="https://dori-homepage.mind-pixels.com/" />
    <meta property="og:image" content="https://dori-homepage.mind-pixels.com/og.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Dori — A little world of my own" />
    <meta name="twitter:description" content="Favorite words, cinematic photos, and beloved books." />
    <meta name="twitter:image" content="https://dori-homepage.mind-pixels.com/og.png" />
    <link rel="preload" href="/sphinx-hero.webp" as="image" type="image/webp" />
    <link rel="icon" href="data:," />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to Dori's world</a>

    <main id="main">
      <section class="hero" id="home" aria-labelledby="site-title" data-weather="clear" data-day="0">
        <img class="hero__image" src="/sphinx-hero.webp" alt="A marble Greek sphinx with a woman's face, lion's body, and eagle wings beneath a moonlit sky" width="1672" height="940" />
        <span class="hero__sun" aria-hidden="true"></span>
        <div class="hero__weather" aria-hidden="true"></div>
        <div class="hero__shade" aria-hidden="true"></div>
        <div class="hero__grain" aria-hidden="true"></div>
        <p class="visually-hidden" id="weather-status" aria-live="polite">Showing the original moonlit sky.</p>

        <header class="wordmark">
          <p class="wordmark__name" id="site-title">Dori</p>
          <p class="wordmark__tagline">A little world of my own</p>
        </header>

        <nav class="portal-nav" aria-label="Enter a section">
          <a class="portal portal--photo" href="#photo" data-open="photo">
            <span class="portal__sigil" aria-hidden="true">✦</span>
            <span class="portal__label">Photo</span>
            <span class="portal__line" aria-hidden="true"></span>
          </a>
          <a class="portal portal--diary" href="#diary" data-open="diary">
            <span class="portal__line" aria-hidden="true"></span>
            <span class="portal__label">Diary</span>
            <span class="portal__sigil portal__sigil--moon" aria-hidden="true">☾</span>
          </a>
          <a class="portal portal--library" href="#library" data-open="library">
            <span class="portal__sigil" aria-hidden="true">◇</span>
            <span class="portal__label">Library</span>
            <span class="portal__line" aria-hidden="true"></span>
          </a>
        </nav>

        <p class="hero__invitation">Choose a corner to begin</p>
      </section>

      <section class="realm realm--diary is-dreamscape" id="diary" data-realm="diary" aria-labelledby="diary-title" hidden>
        <header class="realm-header">
          <div class="realm-header__actions">
            <button class="home-button home-button--icon" type="button" data-home aria-label="Return to the home page" title="Return to the home page">
              <span class="house-icon" aria-hidden="true">
                <span class="house-icon__chimney"></span>
                <span class="house-icon__roof"></span>
                <span class="house-icon__body">
                  <span class="house-icon__window house-icon__window--left"></span>
                  <span class="house-icon__door"></span>
                  <span class="house-icon__window house-icon__window--right"></span>
                </span>
              </span>
            </button>
            <button class="greek-key-button" id="greek-key-button" type="button" aria-label="Open the Greek writing room" title="Open the Greek writing room" aria-expanded="false" aria-controls="greek-keyboard">
              <svg aria-hidden="true" viewBox="0 0 42 22">
                <circle cx="10" cy="11" r="6.5"></circle>
                <path d="M16.5 11H38M29 11v5M35 11v3"></path>
              </svg>
            </button>
          </div>
          <p>01 · Diary</p>
        </header>

        <section class="greek-keyboard" id="greek-keyboard" aria-label="Greek letter keyboard" hidden>
          <div class="greek-keyboard__display">
            <output id="greek-output" class="is-empty" aria-label="Greek message" aria-live="polite"></output>
            <label class="greek-password-toggle" for="show-greek-password">
              <input id="show-greek-password" type="checkbox" />
              <span>Show password</span>
            </label>
          </div>
          <div class="greek-cubes" role="group" aria-label="Greek letters">
            {greekLetters.map(([letter, name]) => (
              <button class="greek-cube" type="button" data-greek-letter={letter} aria-label={`${name}, ${letter}`}>
                <span>{letter}</span>
              </button>
            ))}
          </div>
          <div class="greek-keyboard__controls">
            <button type="button" data-greek-action="space">Space</button>
            <button type="button" data-greek-action="backspace">Backspace</button>
            <button type="button" data-greek-action="clear">Clear</button>
            <button type="button" data-greek-action="close">Close</button>
          </div>
        </section>

        <span class="golden-notes-galaxy" aria-hidden="true"></span>
        <span class="golden-notes-star" aria-hidden="true">
          <span class="golden-notes-star__core"></span>
        </span>

        <div class="realm-intro diary-intro">
          <p class="kicker">Words worth keeping</p>
          <h1 id="diary-title">My constellation<br />of thoughts</h1>
          <p>Little sparks gathered from favorite boards, books, and days.</p>
        </div>

        <div class="board-filter" aria-label="Filter diary boards">
          <button type="button" class="is-active" data-board="dream" aria-pressed="true">Dreamscapes</button>
          <button type="button" data-board="gold" aria-pressed="false">Golden notes</button>
        </div>

        <div class="font-switcher" id="gold-font-switcher" role="group" aria-label="Golden Notes font" hidden>
          <span>Lettering</span>
          <button type="button" class="is-active" data-gold-font="classic" aria-pressed="true">Classic</button>
          <button type="button" data-gold-font="cursive" aria-pressed="false">Cursive</button>
        </div>

        <div class="quote-grid" id="quote-grid">
          {pinterestQuotes.map((quote, index) => (
            <article
              class:list={[
                'quote-card',
                quote.board === 'dream' && 'quote-card--blue',
                pinterestQuotes.findIndex((item) => item.board === quote.board) === index && 'quote-card--feature'
              ]}
              data-board-card={quote.board}
              style={`--dream-bg: url('/dreamscapes/quote-${String(index + 1).padStart(2, '0')}.webp')`}
            >
              <p class="quote-card__board">
                Dreamscapes · {String(
                  pinterestQuotes.slice(0, index + 1).filter((item) => item.board === quote.board).length
                ).padStart(2, '0')}
              </p>
              <blockquote>{quote.text}</blockquote>
              <p class="quote-card__note">
                {quote.credit && <span>{quote.credit} · </span>}
                <a href={`https://www.pinterest.com/pin/${quote.pin}/`} target="_blank" rel="noreferrer">View pin</a>
              </p>
            </article>
          ))}
        </div>

        <details class="diary-composer">
          <summary>Add a thought</summary>
          <form id="diary-form">
            <label for="new-thought">What do you want to remember?</label>
            <textarea id="new-thought" maxlength="180" required placeholder="Write a little thought…"></textarea>
            <div class="composer-row">
              <label for="new-board">Board</label>
              <select id="new-board">
                <option value="dream">Dreamscapes</option>
                <option value="gold">Golden notes</option>
              </select>
              <button type="submit">Keep it</button>
            </div>
            <p class="local-note">Saved only in this browser.</p>
          </form>
        </details>
      </section>

      <section class="realm realm--photo" id="photo" data-realm="photo" aria-labelledby="photo-title" hidden>
        <header class="realm-header">
          <button class="home-button home-button--icon" type="button" data-home aria-label="Return to the home page" title="Return to the home page">
            <span class="house-icon" aria-hidden="true">
              <span class="house-icon__chimney"></span>
              <span class="house-icon__roof"></span>
              <span class="house-icon__body">
                <span class="house-icon__window house-icon__window--left"></span>
                <span class="house-icon__door"></span>
                <span class="house-icon__window house-icon__window--right"></span>
              </span>
            </span>
          </button>
          <p>02 · Photo</p>
        </header>

        <div class="realm-intro photo-intro">
          <p class="kicker">MV style lab</p>
          <h1 id="photo-title">Make a scene</h1>
          <p>Choose a photo and give it a dreamy music-video mood. Everything stays on this device.</p>
        </div>

        <div class="photo-studio">
          <div class="photo-stage" id="photo-stage">
            <div class="photo-empty" id="photo-empty">
              <span aria-hidden="true">☾</span>
              <p>Your photo becomes<br />the main character.</p>
            </div>
            <canvas id="photo-canvas" width="1200" height="900" aria-label="Styled photo preview" hidden></canvas>
            <p class="photo-timestamp" id="photo-timestamp">BLUE HOUR · 00:17</p>
          </div>

          <div class="photo-tools">
            <label class="upload-button" for="photo-input"><span aria-hidden="true">◎</span> Take or choose a photo</label>
            <input id="photo-input" type="file" accept="image/*" capture="user" />

            <fieldset class="photo-adjustments" id="photo-adjustments" hidden>
              <legend>Crop &amp; adjust</legend>
              <p class="photo-adjustments__hint">Drag the photo to place it inside the frame.</p>

              <div class="photo-adjustment">
                <label for="photo-zoom"><span>Zoom</span><output id="photo-zoom-value" for="photo-zoom">100%</output></label>
                <input id="photo-zoom" type="range" min="100" max="250" value="100" step="1" data-photo-adjust="zoom" />
              </div>
              <div class="photo-adjustment">
                <label for="photo-x"><span>Left · right</span><output id="photo-x-value" for="photo-x">Center</output></label>
                <input id="photo-x" type="range" min="-100" max="100" value="0" step="1" data-photo-adjust="x" />
              </div>
              <div class="photo-adjustment">
                <label for="photo-y"><span>Up · down</span><output id="photo-y-value" for="photo-y">Center</output></label>
                <input id="photo-y" type="range" min="-100" max="100" value="0" step="1" data-photo-adjust="y" />
              </div>
              <div class="photo-adjustment">
                <label for="photo-brightness"><span>Brightness</span><output id="photo-brightness-value" for="photo-brightness">100%</output></label>
                <input id="photo-brightness" type="range" min="65" max="140" value="100" step="1" data-photo-adjust="brightness" />
              </div>
              <div class="photo-adjustment">
                <label for="photo-contrast"><span>Contrast</span><output id="photo-contrast-value" for="photo-contrast">100%</output></label>
                <input id="photo-contrast" type="range" min="65" max="150" value="100" step="1" data-photo-adjust="contrast" />
              </div>

              <button type="button" id="reset-photo-adjustments">Reset crop</button>
            </fieldset>

            <fieldset class="sticker-picker" id="sticker-picker" hidden>
              <legend>Add stickers</legend>
              <p class="sticker-picker__hint">Tap a sticker, then drag it anywhere on your photo.</p>
              <div class="sticker-picker__choices">
                <button type="button" data-sticker="star" aria-label="Add a golden star sticker">✦</button>
                <button type="button" data-sticker="moon" aria-label="Add a silver moon sticker">☾</button>
                <button type="button" data-sticker="heart" aria-label="Add a pink heart sticker">♥</button>
                <button type="button" data-sticker="sparkle" aria-label="Add a bright sparkle sticker">✧</button>
                <button type="button" data-sticker="flower" aria-label="Add a lavender flower sticker">❀</button>
                <button type="button" data-sticker="crown" aria-label="Add a golden crown sticker">♕</button>
                <button type="button" data-sticker="butterfly" aria-label="Add a butterfly sticker">🦋</button>
                <button type="button" data-sticker="bow" aria-label="Add a pink bow sticker">୨୧</button>
                <button type="button" data-sticker="music" aria-label="Add a music sticker">♫</button>
                <button type="button" data-sticker="cloud" aria-label="Add a cloud sticker">☁</button>
                <button type="button" data-sticker="lightning" aria-label="Add a lightning sticker">ϟ</button>
                <button type="button" data-sticker="diamond" aria-label="Add a diamond sticker">♦</button>
                <button type="button" data-sticker="sun" aria-label="Add a sun sticker">☼</button>
                <button type="button" data-sticker="comet" aria-label="Add a comet sticker">☄</button>
              </div>
              <button class="sticker-picker__remove" id="remove-sticker" type="button" disabled>Remove selected sticker</button>
            </fieldset>

            <fieldset class="mood-picker">
              <legend>Choose a mood</legend>
              <button type="button" class="is-active" data-mood="blue" aria-pressed="true"><span class="swatch swatch--blue"></span> Blue Hour</button>
              <button type="button" data-mood="gold" aria-pressed="false"><span class="swatch swatch--gold"></span> Golden Film</button>
              <button type="button" data-mood="dream" aria-pressed="false"><span class="swatch swatch--dream"></span> Dream Bloom</button>
              <button type="button" data-mood="neon" aria-pressed="false"><span class="swatch swatch--neon"></span> Neon Dream</button>
              <button type="button" data-mood="noir" aria-pressed="false"><span class="swatch swatch--noir"></span> Silver Noir</button>
              <button type="button" data-mood="retro" aria-pressed="false"><span class="swatch swatch--retro"></span> Retro Reel</button>
            </fieldset>

            <div class="photo-actions">
              <button class="save-photo" id="save-photo" type="button" disabled>Save styled photo</button>
              <button class="delete-photo" id="delete-photo" type="button" disabled>Delete photo</button>
            </div>
            <p class="local-note"><span aria-hidden="true">◇</span> Photos never leave your device.</p>
          </div>
        </div>

        <section class="myth-maker" aria-labelledby="myth-maker-title">
          <header class="myth-maker__header">
            <div>
              <p class="kicker">The mythmaker</p>
              <h2 id="myth-maker-title">Who would you become?</h2>
            </div>
            <p>Answer five “would you rather” questions and reveal your own creature, goddess, or human hero.</p>
          </header>

          <form class="myth-quiz" id="myth-quiz">
            <fieldset class="myth-question myth-question--identity" data-myth-question="form">
              <legend><span>01</span><span class="myth-question__prompt">Would you rather become…</span></legend>
              <div class="myth-choices">
                <button type="button" data-myth-answer="creature" aria-pressed="false">A magical creature</button>
                <button type="button" data-myth-answer="god" aria-pressed="false">A Greek god</button>
                <button type="button" data-myth-answer="goddess" aria-pressed="false">A Greek goddess</button>
                <button type="button" data-myth-answer="girl" aria-pressed="false">A mortal girl</button>
                <button type="button" data-myth-answer="boy" aria-pressed="false">A mortal boy</button>
              </div>
            </fieldset>

            <fieldset class="myth-question" data-myth-question="light" disabled>
              <legend><span>02</span><span class="myth-question__prompt">Choose who you become first.</span></legend>
              <div class="myth-choices">
                <button type="button" data-myth-answer="moon" aria-pressed="false">Moonlight</button>
                <button type="button" data-myth-answer="sun" aria-pressed="false">Sunlight</button>
              </div>
            </fieldset>

            <fieldset class="myth-question" data-myth-question="realm" disabled>
              <legend><span>03</span><span class="myth-question__prompt">Your adventure will appear here.</span></legend>
              <div class="myth-choices">
                <button type="button" data-myth-answer="sea" aria-pressed="false">A hidden sea</button>
                <button type="button" data-myth-answer="stars" aria-pressed="false">The endless stars</button>
              </div>
            </fieldset>

            <fieldset class="myth-question" data-myth-question="gift" disabled>
              <legend><span>04</span><span class="myth-question__prompt">Your magical gift will appear here.</span></legend>
              <div class="myth-choices">
                <button type="button" data-myth-answer="wings" aria-pressed="false">Celestial wings</button>
                <button type="button" data-myth-answer="crown" aria-pressed="false">Golden crown</button>
              </div>
            </fieldset>

            <fieldset class="myth-question" data-myth-question="virtue" disabled>
              <legend><span>05</span><span class="myth-question__prompt">Your greatest strength will appear here.</span></legend>
              <div class="myth-choices">
                <button type="button" data-myth-answer="courage" aria-pressed="false">A courageous heart</button>
                <button type="button" data-myth-answer="wisdom" aria-pressed="false">Ancient wisdom</button>
              </div>
            </fieldset>

            <div class="myth-quiz__finish">
              <p id="myth-progress" aria-live="polite">Choose one answer in every row.</p>
              <button class="myth-reveal" id="myth-reveal" type="submit" disabled>Reveal my character</button>
            </div>
          </form>

          <article class="myth-result" id="myth-result" aria-live="polite" hidden>
            <div class="myth-portrait" id="myth-portrait" data-light="moon">
              <canvas id="myth-canvas" width="900" height="1100" aria-label="Your generated myth character portrait"></canvas>
            </div>
            <div class="myth-result__copy">
              <p class="myth-result__eyebrow" id="myth-title">The Moonlit Star-Walker</p>
              <h3 id="myth-name">Elara</h3>
              <p id="myth-description"></p>
              <ul class="myth-powers" id="myth-powers" aria-label="Character powers"></ul>
              <div class="myth-result__actions">
                <button class="myth-save" id="myth-save" type="button">Save character image</button>
                <button class="myth-again" id="myth-again" type="button">Answer again</button>
              </div>
            </div>
          </article>
        </section>
      </section>

      <section class="realm realm--library" id="library" data-realm="library" aria-labelledby="library-title" hidden>
        <header class="realm-header">
          <button class="home-button home-button--icon" type="button" data-home aria-label="Return to the home page" title="Return to the home page">
            <span class="house-icon" aria-hidden="true">
              <span class="house-icon__chimney"></span>
              <span class="house-icon__roof"></span>
              <span class="house-icon__body">
                <span class="house-icon__window house-icon__window--left"></span>
                <span class="house-icon__door"></span>
                <span class="house-icon__window house-icon__window--right"></span>
              </span>
            </span>
          </button>
          <p>03 · Library</p>
        </header>

        <div class="realm-intro library-intro">
          <p class="kicker">6 volumes · your shelf</p>
          <h1 id="library-title">The Bookshelf</h1>
          <p>Pick a spine to open the note tucked inside.</p>
        </div>

        <div class="library-room">
          <div class="bookshelf" aria-label="Dori's books">
            <button class="book book--navy is-selected" type="button" data-book="wild" aria-label="Untitled book" aria-pressed="true">
              <span class="book__title" aria-hidden="true"></span>
            </button>
            <button class="book book--gold book--short" type="button" data-book="wrinkle" aria-label="Untitled book" aria-pressed="false">
              <span class="book__title" aria-hidden="true"></span>
            </button>
            <button class="book book--black book--tall" type="button" data-book="moon" aria-label="Untitled book" aria-pressed="false">
              <span class="book__title" aria-hidden="true"></span>
            </button>
            <button class="book book--mist book--short" type="button" data-book="garden" aria-label="Untitled book" aria-pressed="false">
              <span class="book__title" aria-hidden="true"></span>
            </button>
            <button class="book book--navy book--thin" type="button" data-book="reach" aria-label="Untitled book" aria-pressed="false">
              <span class="book__title" aria-hidden="true"></span>
            </button>
            <button class="book book--gold" type="button" data-book="anne" aria-label="Untitled book" aria-pressed="false">
              <span class="book__title" aria-hidden="true"></span>
            </button>
            <span class="shelf-edge" aria-hidden="true"></span>
            <a class="book medusa-book" href="/medusa/" aria-label="Open the Medusa volume" title="Open the Medusa volume">
              <span class="medusa-book__bands" aria-hidden="true"></span>
              <span class="book__title medusa-book__title" aria-hidden="true">Medusa</span>
            </a>
          </div>

          <aside class="book-note" aria-live="polite">
            <p class="book-note__kicker">A note tucked inside</p>
            <h2 id="book-title">Untitled volume</h2>
            <label class="book-title-editor" for="book-title-input">Write on the spine</label>
            <input id="book-title-input" type="text" maxlength="42" autocomplete="off" placeholder="Type a book title…" />
            <div class="book-arrange" role="group" aria-label="Arrange selected book">
              <button type="button" id="move-book-left">← Move left</button>
              <button type="button" id="move-book-right">Move right →</button>
            </div>
            <p id="book-copy" hidden></p>
            <button type="button" id="book-reminder">Mark for tonight</button>
          </aside>
        </div>
      </section>
    </main>

    <script is:inline>
      const hero = document.getElementById('home');
      const heroImage = hero.querySelector('.hero__image');
      const weatherStatus = document.getElementById('weather-status');
      const realms = [...document.querySelectorAll('[data-realm]')];
      const portals = [...document.querySelectorAll('[data-open]')];

      function weatherKind(code) {
        if (code <= 1) return ['clear', code === 0 ? 'clear skies' : 'mostly clear skies'];
        if (code <= 3) return ['cloudy', code === 2 ? 'partly cloudy skies' : 'cloudy skies'];
        if (code === 45 || code === 48) return ['fog', 'misty weather'];
        if ((code >= 51 && code <= 67) || (code >= 80 && code <= 82)) return ['rain', 'rainy weather'];
        if ((code >= 71 && code <= 77) || code === 85 || code === 86) return ['snow', 'snowy weather'];
        if (code >= 95) return ['storm', 'stormy weather'];
        return ['cloudy', 'changing skies'];
      }

      async function setWeatherFromLocation(position) {
        const latitude = Number(position.coords.latitude.toFixed(2));
        const longitude = Number(position.coords.longitude.toFixed(2));
        const endpoint = new URL('https://api.open-meteo.com/v1/forecast');
        endpoint.searchParams.set('latitude', String(latitude));
        endpoint.searchParams.set('longitude', String(longitude));
        endpoint.searchParams.set('current', 'weather_code,is_day');
        endpoint.searchParams.set('timezone', 'auto');

        try {
          const response = await fetch(endpoint, { cache: 'no-store' });
          if (!response.ok) throw new Error('Weather unavailable');
          const weather = (await response.json()).current;
          const [kind, label] = weatherKind(Number(weather.weather_code));
          const isDay = Number(weather.is_day) === 1;
          hero.dataset.weather = kind;
          if (isDay) {
            const daylightImage = new Image();
            daylightImage.src = '/sphinx-hero-day-v1.webp';
            try {
              await daylightImage.decode();
              heroImage.src = daylightImage.src;
              hero.dataset.day = '1';
            } catch {
              hero.dataset.day = '0';
            }
          } else {
            heroImage.src = '/sphinx-hero.webp';
            hero.dataset.day = '0';
          }
          heroImage.alt = `A marble Greek sphinx beneath ${label} ${isDay ? 'in daylight' : 'at night'}`;
          weatherStatus.textContent = `The sphinx scene is reflecting ${label} near you.`;
        } catch {
          weatherStatus.textContent = 'Live weather is unavailable, so the original moonlit sky is showing.';
        }
      }

      if ('geolocation' in navigator) {
        navigator.geolocation.getCurrentPosition(setWeatherFromLocation, () => {
          weatherStatus.textContent = 'Location was not shared, so the original moonlit sky is showing.';
        }, { enableHighAccuracy: false, maximumAge: 600000, timeout: 8000 });
      }

      function openRealm(name, updateHistory = true) {
        const realm = document.querySelector(`[data-realm="${name}"]`);
        if (!realm) return;
        hero.hidden = true;
        realms.forEach((item) => item.hidden = item !== realm);
        document.body.dataset.view = name;
        if (updateHistory) history.pushState({ realm: name }, '', `#${name}`);
        requestAnimationFrame(() => realm.querySelector('h1')?.focus?.({ preventScroll: true }));
        window.scrollTo({ top: 0, behavior: 'instant' });
      }

      function openHome(updateHistory = true) {
        realms.forEach((realm) => realm.hidden = true);
        hero.hidden = false;
        delete document.body.dataset.view;
        if (updateHistory) history.pushState({}, '', location.pathname);
        window.scrollTo({ top: 0, behavior: 'instant' });
        document.querySelector('.portal--photo')?.focus({ preventScroll: true });
      }

      portals.forEach((portal) => portal.addEventListener('click', (event) => {
        event.preventDefault();
        openRealm(portal.dataset.open);
      }));
      document.querySelectorAll('[data-home]').forEach((button) => button.addEventListener('click', () => openHome()));
      addEventListener('popstate', () => {
        const name = location.hash.slice(1);
        name ? openRealm(name, false) : openHome(false);
      });
      addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && hero.hidden) openHome();
      });

      const initialRealm = location.hash.slice(1);
      if (['diary', 'photo', 'library'].includes(initialRealm)) openRealm(initialRealm, false);

      const greekKeyButton = document.getElementById('greek-key-button');
      const greekKeyboard = document.getElementById('greek-keyboard');
      const greekOutput = document.getElementById('greek-output');
      const showGreekPassword = document.getElementById('show-greek-password');
      const diaryRealm = document.querySelector('.realm--diary');
      const greekLineKey = 'dori-greek-line';
      const greekDoorCodes = new Set(['ΔΟΡΙΑΝΑ', 'ΝΤΟΡΙΑΝΑ']);
      let greekLine = localStorage.getItem(greekLineKey) || '';

      function renderGreekLine() {
        greekOutput.textContent = showGreekPassword.checked ? greekLine : greekLine.replace(/\S/g, '•');
        greekOutput.classList.toggle('is-empty', !greekLine);
      }

      function saveGreekLine(nextLine) {
        greekOutput.classList.remove('is-unlocked');
        greekLine = Array.from(nextLine).slice(0, 48).join('');
        localStorage.setItem(greekLineKey, greekLine);
        renderGreekLine();
        const doorCode = greekLine.replace(/\s/g, '');
        if (greekDoorCodes.has(doorCode)) {
          showGreekPassword.checked = true;
          greekOutput.classList.add('is-unlocked');
          renderGreekLine();
          localStorage.removeItem(greekLineKey);
          window.setTimeout(() => window.location.assign('https://jingliu-preview.mind-pixels.com/'), 500);
        }
      }

      function setGreekKeyboard(open) {
        greekKeyboard.hidden = !open;
        greekKeyButton.classList.toggle('is-active', open);
        greekKeyButton.setAttribute('aria-expanded', String(open));
        greekKeyButton.setAttribute('aria-label', open ? 'Close the Greek writing room' : 'Open the Greek writing room');
        greekKeyButton.title = open ? 'Close the Greek writing room' : 'Open the Greek writing room';
        diaryRealm.classList.toggle('is-greek-room', open);
        if (open) {
          greekOutput.classList.remove('is-unlocked');
          showGreekPassword.checked = false;
          renderGreekLine();
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }
      }

      greekKeyButton.addEventListener('click', () => setGreekKeyboard(greekKeyboard.hidden));
      showGreekPassword.addEventListener('change', renderGreekLine);
      document.querySelectorAll('[data-greek-letter]').forEach((button) => {
        button.addEventListener('click', () => saveGreekLine(greekLine + button.dataset.greekLetter));
      });
      document.querySelector('[data-greek-action="space"]').addEventListener('click', () => {
        if (greekLine && !greekLine.endsWith(' ')) saveGreekLine(`${greekLine} `);
      });
      document.querySelector('[data-greek-action="backspace"]').addEventListener('click', () => {
        saveGreekLine(Array.from(greekLine).slice(0, -1).join(''));
      });
      document.querySelector('[data-greek-action="clear"]').addEventListener('click', () => saveGreekLine(''));
      document.querySelector('[data-greek-action="close"]').addEventListener('click', () => {
        setGreekKeyboard(false);
        greekKeyButton.focus();
      });
      renderGreekLine();

      const boardButtons = [...document.querySelectorAll('[data-board]')];
      const newBoardSelect = document.getElementById('new-board');
      boardButtons.forEach((button) => button.addEventListener('click', () => {
        const board = button.dataset.board;
        boardButtons.forEach((item) => {
          const active = item === button;
          item.classList.toggle('is-active', active);
          item.setAttribute('aria-pressed', String(active));
        });
        document.querySelectorAll('[data-board-card]').forEach((card) => {
          card.hidden = card.dataset.boardCard !== board;
        });
        diaryRealm.classList.toggle('is-dreamscape', board === 'dream');
        diaryRealm.classList.toggle('is-golden-notes', board === 'gold');
        document.getElementById('gold-font-switcher').hidden = board !== 'gold';
        newBoardSelect.value = board;
      }));

      const diaryForm = document.getElementById('diary-form');
      const quoteGrid = document.getElementById('quote-grid');
      const diaryMergeKey = 'dori-diary-golden-notes-reset';
      let savedThoughts = JSON.parse(localStorage.getItem('dori-diary') || '[]');
      if (!localStorage.getItem(diaryMergeKey)) {
        savedThoughts = savedThoughts.map((thought) => ({ ...thought, board: 'dream' }));
        localStorage.setItem('dori-diary', JSON.stringify(savedThoughts));
        localStorage.setItem(diaryMergeKey, '1');
      }

      function makeThoughtId() {
        return crypto.randomUUID?.() || `note-${Date.now()}-${Math.random().toString(16).slice(2)}`;
      }

      let addedThoughtIds = false;
      savedThoughts = savedThoughts.map((thought) => {
        if (thought.id) return thought;
        addedThoughtIds = true;
        return { ...thought, id: makeThoughtId() };
      });
      if (addedThoughtIds) localStorage.setItem('dori-diary', JSON.stringify(savedThoughts));

      const boardNames = { dream: 'Dreamscapes', gold: 'Golden notes' };
      const goldFontButtons = [...document.querySelectorAll('[data-gold-font]')];
      let goldFont = localStorage.getItem('dori-golden-notes-font') || 'classic';

      function applyGoldFont() {
        document.querySelectorAll('[data-board-card="gold"]').forEach((card) => {
          card.classList.toggle('quote-card--cursive', goldFont === 'cursive');
        });
        goldFontButtons.forEach((button) => {
          const active = button.dataset.goldFont === goldFont;
          button.classList.toggle('is-active', active);
          button.setAttribute('aria-pressed', String(active));
        });
      }

      goldFontButtons.forEach((button) => button.addEventListener('click', () => {
        goldFont = button.dataset.goldFont;
        localStorage.setItem('dori-golden-notes-font', goldFont);
        applyGoldFont();
      }));

      function addThoughtCard(thought) {
        const card = document.createElement('article');
        card.className = `quote-card ${thought.board === 'dream' ? 'quote-card--blue' : ''}`;
        if (thought.board === 'gold' && goldFont === 'cursive') card.classList.add('quote-card--cursive');
        card.dataset.boardCard = thought.board;
        const label = document.createElement('p');
        label.className = 'quote-card__board';
        label.textContent = `${boardNames[thought.board]} · Mine`;
        const quote = document.createElement('blockquote');
        quote.textContent = thought.text;
        const note = document.createElement('p');
        note.className = 'quote-card__note';
        note.textContent = 'Saved in this browser.';
        card.append(label, quote, note);

        if (thought.board === 'gold') {
          const actions = document.createElement('div');
          actions.className = 'note-actions';
          const editButton = document.createElement('button');
          editButton.className = 'edit-note';
          editButton.type = 'button';
          editButton.textContent = 'Edit note';
          editButton.setAttribute('aria-label', 'Edit this Golden Note');
          const deleteButton = document.createElement('button');
          deleteButton.className = 'delete-note';
          deleteButton.type = 'button';
          deleteButton.textContent = 'Delete note';
          deleteButton.setAttribute('aria-label', 'Delete this Golden Note');
          deleteButton.addEventListener('click', () => {
            if (!window.confirm('Delete this Golden Note? This cannot be undone.')) return;
            savedThoughts = savedThoughts.filter((item) => item.id !== thought.id);
            localStorage.setItem('dori-diary', JSON.stringify(savedThoughts));
            card.remove();
          });

          editButton.addEventListener('click', () => {
            if (card.querySelector('.note-editor')) return;
            const editorPanel = document.createElement('div');
            editorPanel.className = 'note-editor-panel';
            const editor = document.createElement('textarea');
            editor.className = 'note-editor';
            editor.maxLength = 180;
            editor.value = thought.text;
            editor.setAttribute('aria-label', 'Edit Golden Note text');
            const editorActions = document.createElement('div');
            editorActions.className = 'note-editor-actions';
            const saveButton = document.createElement('button');
            saveButton.type = 'button';
            saveButton.textContent = 'Save changes';
            const cancelButton = document.createElement('button');
            cancelButton.type = 'button';
            cancelButton.textContent = 'Cancel';

            function closeEditor() {
              editorPanel.remove();
              quote.hidden = false;
              note.hidden = false;
              actions.hidden = false;
            }

            function saveEdit() {
              const text = editor.value.trim();
              if (!text) {
                editor.focus();
                return;
              }
              thought.text = text;
              savedThoughts = savedThoughts.map((item) => item.id === thought.id ? { ...item, text } : item);
              localStorage.setItem('dori-diary', JSON.stringify(savedThoughts));
              quote.textContent = text;
              closeEditor();
            }

            saveButton.addEventListener('click', saveEdit);
            cancelButton.addEventListener('click', closeEditor);
            editor.addEventListener('keydown', (event) => {
              if (event.key === 'Escape') closeEditor();
              if ((event.metaKey || event.ctrlKey) && event.key === 'Enter') saveEdit();
            });
            editorActions.append(saveButton, cancelButton);
            editorPanel.append(editor, editorActions);
            quote.hidden = true;
            note.hidden = true;
            actions.hidden = true;
            card.append(editorPanel);
            editor.focus();
            editor.setSelectionRange(editor.value.length, editor.value.length);
          });

          actions.append(editButton, deleteButton);
          card.append(actions);
        }

        quoteGrid.prepend(card);
      }
      savedThoughts.forEach(addThoughtCard);
      applyGoldFont();

      diaryForm.addEventListener('submit', (event) => {
        event.preventDefault();
        const text = document.getElementById('new-thought').value.trim();
        const board = newBoardSelect.value;
        if (!text) return;
        const thought = { id: makeThoughtId(), text, board };
        savedThoughts.unshift(thought);
        localStorage.setItem('dori-diary', JSON.stringify(savedThoughts.slice(0, 24)));
        addThoughtCard(thought);
        diaryForm.reset();
        document.querySelector('.diary-composer').open = false;
        document.querySelector(`[data-board="${board}"]`).click();
      });

      document.querySelector('[data-board="dream"]').click();

      const input = document.getElementById('photo-input');
      const canvas = document.getElementById('photo-canvas');
      const context = canvas.getContext('2d');
      const empty = document.getElementById('photo-empty');
      const savePhoto = document.getElementById('save-photo');
      const timestamp = document.getElementById('photo-timestamp');
      const photoRealm = document.getElementById('photo');
      const photoStage = document.getElementById('photo-stage');
      const photoAdjustments = document.getElementById('photo-adjustments');
      const photoControls = [...document.querySelectorAll('[data-photo-adjust]')];
      const stickerPicker = document.getElementById('sticker-picker');
      const removeStickerButton = document.getElementById('remove-sticker');
      const deletePhotoButton = document.getElementById('delete-photo');
      const ambienceCanvas = document.createElement('canvas');
      ambienceCanvas.width = 36;
      ambienceCanvas.height = 36;
      const ambienceContext = ambienceCanvas.getContext('2d', { willReadFrequently: true });
      let sourceImage = null;
      let mood = 'blue';
      let photoSettings = { zoom: 1, x: 0, y: 0, brightness: 1, contrast: 1 };
      let photoDrag = null;
      let stickers = [];
      let selectedStickerId = null;

      const moods = {
        blue: { filter: 'contrast(1.13) saturate(.72) hue-rotate(8deg) brightness(.92)', caption: 'BLUE HOUR · 00:17', color: 'rgba(54, 107, 160, .18)' },
        gold: { filter: 'sepia(.34) saturate(1.16) contrast(1.05) brightness(1.03)', caption: 'GOLDEN FILM · TAKE 03', color: 'rgba(188, 121, 34, .15)' },
        dream: { filter: 'saturate(.8) contrast(.92) brightness(1.08) hue-rotate(18deg)', caption: 'DREAM BLOOM · SCENE 09', color: 'rgba(147, 106, 190, .16)' },
        neon: { filter: 'saturate(1.75) contrast(1.18) hue-rotate(18deg) brightness(.96)', caption: 'NEON DREAM · AFTER DARK', color: 'rgba(125, 48, 225, .16)' },
        noir: { filter: 'grayscale(1) contrast(1.3) brightness(.9)', caption: 'SILVER NOIR · FRAME 11', color: 'rgba(213, 225, 239, .1)' },
        retro: { filter: 'sepia(.5) saturate(.85) contrast(1.08) brightness(.94)', caption: 'RETRO REEL · 1997', color: 'rgba(182, 108, 50, .15)' }
      };

      const stickerCatalog = {
        star: { glyph: '✦', color: '#f4d278', glow: 'rgba(244,210,120,.85)' },
        moon: { glyph: '☾', color: '#dcecf7', glow: 'rgba(169,211,240,.82)' },
        heart: { glyph: '♥', color: '#ef9db7', glow: 'rgba(239,157,183,.76)' },
        sparkle: { glyph: '✧', color: '#fff2c5', glow: 'rgba(255,242,197,.92)' },
        flower: { glyph: '❀', color: '#d7b9ef', glow: 'rgba(215,185,239,.78)' },
        crown: { glyph: '♕', color: '#e9bd62', glow: 'rgba(233,189,98,.82)' },
        butterfly: { glyph: '🦋', color: '#b9a7ff', glow: 'rgba(185,167,255,.8)' },
        bow: { glyph: '୨୧', color: '#f2b1cc', glow: 'rgba(242,177,204,.82)' },
        music: { glyph: '♫', color: '#9fd8f7', glow: 'rgba(159,216,247,.82)' },
        cloud: { glyph: '☁', color: '#dfeaf3', glow: 'rgba(223,234,243,.76)' },
        lightning: { glyph: 'ϟ', color: '#ffd86b', glow: 'rgba(255,216,107,.9)' },
        diamond: { glyph: '♦', color: '#a6e8f0', glow: 'rgba(166,232,240,.82)' },
        sun: { glyph: '☼', color: '#f4c95d', glow: 'rgba(244,201,93,.88)' },
        comet: { glyph: '☄', color: '#cbb4ff', glow: 'rgba(203,180,255,.84)' }
      };

      function matchBackgroundToSubject() {
        ambienceContext.clearRect(0, 0, 36, 36);
        ambienceContext.drawImage(canvas, 0, 0, 36, 36);
        const pixels = ambienceContext.getImageData(8, 5, 20, 27).data;
        let red = 0;
        let green = 0;
        let blue = 0;
        let totalWeight = 0;

        for (let index = 0; index < pixels.length; index += 4) {
          const r = pixels[index];
          const g = pixels[index + 1];
          const b = pixels[index + 2];
          const brightest = Math.max(r, g, b);
          const darkest = Math.min(r, g, b);
          const lightness = (brightest + darkest) / 510;
          if (lightness < .04 || lightness > .97) continue;
          const colorfulness = (brightest - darkest) / 255;
          const weight = .55 + colorfulness * 1.7;
          red += r * weight;
          green += g * weight;
          blue += b * weight;
          totalWeight += weight;
        }

        if (!totalWeight) return;
        const sampled = [red, green, blue].map((channel) => channel / totalWeight);
        const average = (sampled[0] + sampled[1] + sampled[2]) / 3;
        const accent = sampled.map((channel) => Math.round(Math.max(18, Math.min(238, average + (channel - average) * 1.28))));
        photoRealm.style.setProperty('--photo-accent-rgb', accent.join(', '));
      }

      function drawStickers(showSelection) {
        const shortestSide = Math.min(canvas.width, canvas.height);
        context.save();
        context.textAlign = 'center';
        context.textBaseline = 'middle';
        stickers.forEach((sticker) => {
          const style = stickerCatalog[sticker.type];
          const size = shortestSide * sticker.size;
          const x = sticker.x * canvas.width;
          const y = sticker.y * canvas.height;
          context.font = `600 ${size}px Georgia, "Apple Color Emoji", "Segoe UI Emoji", serif`;
          context.fillStyle = style.color;
          context.shadowColor = style.glow;
          context.shadowBlur = size * .2;
          context.fillText(style.glyph, x, y);

          if (showSelection && sticker.id === selectedStickerId) {
            context.shadowBlur = 0;
            context.setLineDash([size * .08, size * .06]);
            context.lineWidth = Math.max(2, size * .018);
            context.strokeStyle = 'rgba(255,242,204,.9)';
            context.beginPath();
            context.arc(x, y, size * .62, 0, Math.PI * 2);
            context.stroke();
          }
        });
        context.restore();
      }

      function renderPhoto(showStickerSelection = true) {
        if (!sourceImage) return;
        const stageWidth = photoStage.clientWidth;
        const stageHeight = photoStage.clientHeight;
        if (!stageWidth || !stageHeight) return;
        const stageRatio = stageWidth / stageHeight;
        if (stageRatio >= 1) {
          canvas.width = 1200;
          canvas.height = Math.round(1200 / stageRatio);
        } else {
          canvas.height = 1200;
          canvas.width = Math.round(1200 * stageRatio);
        }
        const width = canvas.width;
        const height = canvas.height;
        const scale = Math.max(width / sourceImage.naturalWidth, height / sourceImage.naturalHeight) * photoSettings.zoom;
        const drawWidth = sourceImage.naturalWidth * scale;
        const drawHeight = sourceImage.naturalHeight * scale;
        const maxX = Math.max(0, (drawWidth - width) / 2);
        const maxY = Math.max(0, (drawHeight - height) / 2);
        const drawX = (width - drawWidth) / 2 + (photoSettings.x / 100) * maxX;
        const drawY = (height - drawHeight) / 2 + (photoSettings.y / 100) * maxY;
        context.clearRect(0, 0, width, height);
        context.filter = `${moods[mood].filter} brightness(${photoSettings.brightness}) contrast(${photoSettings.contrast})`;
        context.drawImage(sourceImage, drawX, drawY, drawWidth, drawHeight);
        context.filter = 'none';
        const wash = context.createLinearGradient(0, 0, width, height);
        wash.addColorStop(0, moods[mood].color);
        wash.addColorStop(.56, 'rgba(0,0,0,0)');
        wash.addColorStop(1, 'rgba(3,6,12,.18)');
        context.fillStyle = wash;
        context.fillRect(0, 0, width, height);
        timestamp.textContent = moods[mood].caption;
        matchBackgroundToSubject();
        drawStickers(showStickerSelection);
      }

      function syncPhotoControls() {
        const values = {
          zoom: Math.round(photoSettings.zoom * 100),
          x: Math.round(photoSettings.x),
          y: Math.round(photoSettings.y),
          brightness: Math.round(photoSettings.brightness * 100),
          contrast: Math.round(photoSettings.contrast * 100)
        };
        photoControls.forEach((control) => control.value = values[control.dataset.photoAdjust]);
        document.getElementById('photo-zoom-value').value = `${values.zoom}%`;
        document.getElementById('photo-x-value').value = values.x === 0 ? 'Center' : `${Math.abs(values.x)}% ${values.x < 0 ? 'left' : 'right'}`;
        document.getElementById('photo-y-value').value = values.y === 0 ? 'Center' : `${Math.abs(values.y)}% ${values.y < 0 ? 'up' : 'down'}`;
        document.getElementById('photo-brightness-value').value = `${values.brightness}%`;
        document.getElementById('photo-contrast-value').value = `${values.contrast}%`;
      }

      function resetPhotoSettings() {
        photoSettings = { zoom: 1, x: 0, y: 0, brightness: 1, contrast: 1 };
        syncPhotoControls();
        renderPhoto();
      }

      input.addEventListener('change', () => {
        const file = input.files?.[0];
        if (!file) return;
        const url = URL.createObjectURL(file);
        const image = new Image();
        image.onload = () => {
          sourceImage = image;
          stickers = [];
          selectedStickerId = null;
          removeStickerButton.disabled = true;
          resetPhotoSettings();
          canvas.hidden = false;
          empty.hidden = true;
          photoAdjustments.hidden = false;
          stickerPicker.hidden = false;
          photoStage.classList.add('is-editing');
          savePhoto.disabled = false;
          deletePhotoButton.disabled = false;
          URL.revokeObjectURL(url);
        };
        image.src = url;
      });

      photoControls.forEach((control) => control.addEventListener('input', () => {
        const value = Number(control.value);
        const setting = control.dataset.photoAdjust;
        photoSettings[setting] = ['zoom', 'brightness', 'contrast'].includes(setting) ? value / 100 : value;
        syncPhotoControls();
        renderPhoto();
      }));

      document.getElementById('reset-photo-adjustments').addEventListener('click', resetPhotoSettings);

      document.querySelectorAll('[data-sticker]').forEach((button) => button.addEventListener('click', () => {
        if (!sourceImage) return;
        const offset = (stickers.length % 5) * .035;
        const sticker = {
          id: `${Date.now()}-${stickers.length}`,
          type: button.dataset.sticker,
          x: Math.min(.72, .43 + offset),
          y: Math.min(.68, .4 + offset),
          size: .13
        };
        stickers.push(sticker);
        selectedStickerId = sticker.id;
        removeStickerButton.disabled = false;
        renderPhoto();
      }));

      removeStickerButton.addEventListener('click', () => {
        if (!selectedStickerId) return;
        stickers = stickers.filter((sticker) => sticker.id !== selectedStickerId);
        selectedStickerId = null;
        removeStickerButton.disabled = true;
        renderPhoto();
      });

      function canvasPoint(event) {
        const bounds = canvas.getBoundingClientRect();
        return {
          x: (event.clientX - bounds.left) / bounds.width,
          y: (event.clientY - bounds.top) / bounds.height
        };
      }

      function stickerAtPoint(point) {
        const shortestSide = Math.min(canvas.width, canvas.height);
        return [...stickers].reverse().find((sticker) => {
          const distanceX = (point.x - sticker.x) * canvas.width;
          const distanceY = (point.y - sticker.y) * canvas.height;
          const radius = shortestSide * sticker.size * .72;
          return distanceX * distanceX + distanceY * distanceY <= radius * radius;
        });
      }

      photoStage.addEventListener('pointerdown', (event) => {
        if (!sourceImage) return;
        const point = canvasPoint(event);
        const sticker = stickerAtPoint(point);
        if (sticker) {
          selectedStickerId = sticker.id;
          removeStickerButton.disabled = false;
          photoDrag = { kind: 'sticker', pointerId: event.pointerId, stickerId: sticker.id, offsetX: point.x - sticker.x, offsetY: point.y - sticker.y };
          renderPhoto();
        } else {
          selectedStickerId = null;
          removeStickerButton.disabled = true;
          photoDrag = { kind: 'photo', pointerId: event.pointerId, startX: event.clientX, startY: event.clientY, photoX: photoSettings.x, photoY: photoSettings.y };
        }
        photoStage.setPointerCapture(event.pointerId);
        photoStage.classList.add('is-dragging');
      });

      photoStage.addEventListener('pointermove', (event) => {
        if (!photoDrag || event.pointerId !== photoDrag.pointerId) return;
        if (photoDrag.kind === 'sticker') {
          const sticker = stickers.find((item) => item.id === photoDrag.stickerId);
          if (!sticker) return;
          const point = canvasPoint(event);
          const radius = Math.min(canvas.width, canvas.height) * sticker.size * .52;
          const marginX = radius / canvas.width;
          const marginY = radius / canvas.height;
          sticker.x = Math.max(marginX, Math.min(1 - marginX, point.x - photoDrag.offsetX));
          sticker.y = Math.max(marginY, Math.min(1 - marginY, point.y - photoDrag.offsetY));
          renderPhoto();
          return;
        }
        const rect = photoStage.getBoundingClientRect();
        photoSettings.x = Math.max(-100, Math.min(100, photoDrag.photoX + ((event.clientX - photoDrag.startX) / rect.width) * 200));
        photoSettings.y = Math.max(-100, Math.min(100, photoDrag.photoY + ((event.clientY - photoDrag.startY) / rect.height) * 200));
        syncPhotoControls();
        renderPhoto();
      });

