        mythContext.fillStyle = fill;
        mythContext.fill();
        if (stroke) {
          mythContext.lineWidth = lineWidth;
          mythContext.strokeStyle = stroke;
          mythContext.stroke();
        }
      }

      function loadMythPortrait(form) {
        let image = mythPortraitImages[form];
        if (!image) {
          image = new Image();
          image.decoding = 'async';
          image.src = mythPortraitSources[form];
          mythPortraitImages[form] = image;
        }
        if (image.complete) {
          return image.naturalWidth ? Promise.resolve(image) : Promise.reject(new Error(`Could not load ${form} portrait.`));
        }
        return new Promise((resolve, reject) => {
          image.addEventListener('load', () => resolve(image), { once: true });
          image.addEventListener('error', () => reject(new Error(`Could not load ${form} portrait.`)), { once: true });
        });
      }

      async function drawMythPortrait(seed) {
        const width = mythCanvas.width;
        const height = mythCanvas.height;
        const moonlit = mythAnswers.light === 'moon';
        const lightColor = moonlit ? '#b9d9ff' : '#ffd477';
        const deepColor = moonlit ? '#17213f' : '#512b19';
        const portraitImage = await loadMythPortrait(mythAnswers.form);

        mythContext.clearRect(0, 0, width, height);
        const background = mythContext.createLinearGradient(0, 0, width, height);
        background.addColorStop(0, deepColor);
        background.addColorStop(.58, moonlit ? '#261f46' : '#2e1620');
        background.addColorStop(1, '#05070d');
        mythContext.fillStyle = background;
        mythContext.fillRect(0, 0, width, height);

        const aura = mythContext.createRadialGradient(450, 325, 10, 450, 325, 330);
        aura.addColorStop(0, `${lightColor}72`);
        aura.addColorStop(1, `${lightColor}00`);
        mythContext.fillStyle = aura;
        mythContext.fillRect(0, 0, width, height);

        if (mythAnswers.realm === 'stars') {
          for (let index = 0; index < 70; index += 1) {
            const x = (index * 197 + seed * 31) % width;
            const y = (index * 113 + seed * 17) % 950;
            const radius = 1.4 + ((index + seed) % 4) * .65;
            drawMythEllipse(x, y, radius, radius, index % 5 === 0 ? '#fff3c4' : '#dcecff');
          }
        } else {
          mythContext.lineWidth = 5;
          for (let wave = 0; wave < 5; wave += 1) {
            const y = 760 + wave * 64;
            mythContext.beginPath();
            mythContext.moveTo(-30, y);
            mythContext.bezierCurveTo(180, y - 58, 290, y + 52, 450, y);
            mythContext.bezierCurveTo(610, y - 52, 720, y + 58, 930, y);
            mythContext.strokeStyle = wave % 2 ? 'rgba(113,198,229,.28)' : 'rgba(207,239,247,.22)';
            mythContext.stroke();
          }
        }

        mythContext.lineWidth = 4;
        mythContext.strokeStyle = `${lightColor}82`;
        mythContext.beginPath();
        mythContext.arc(450, 340, 268, 0, Math.PI * 2);
        mythContext.stroke();

        if (mythAnswers.gift === 'wings') {
          const wingGradient = mythContext.createLinearGradient(100, 420, 450, 850);
          wingGradient.addColorStop(0, `${lightColor}72`);
          wingGradient.addColorStop(1, `${lightColor}0a`);
          mythContext.fillStyle = wingGradient;
          mythContext.strokeStyle = `${lightColor}a8`;
          mythContext.lineWidth = 3;
          mythContext.beginPath();
          mythContext.moveTo(355, 505);
          mythContext.bezierCurveTo(145, 335, 52, 500, 232, 835);
          mythContext.bezierCurveTo(250, 690, 328, 630, 355, 505);
          mythContext.fill(); mythContext.stroke();
          mythContext.beginPath();
          mythContext.moveTo(545, 505);
          mythContext.bezierCurveTo(755, 335, 848, 500, 668, 835);
          mythContext.bezierCurveTo(650, 690, 572, 630, 545, 505);
          mythContext.fill(); mythContext.stroke();
        }

        const maximumPortraitWidth = width * .98;
        const maximumPortraitHeight = height * .98;
        const portraitScale = Math.min(maximumPortraitWidth / portraitImage.naturalWidth, maximumPortraitHeight / portraitImage.naturalHeight);
        const portraitWidth = portraitImage.naturalWidth * portraitScale;
        const portraitHeight = portraitImage.naturalHeight * portraitScale;
        mythContext.save();
        mythContext.shadowColor = `${lightColor}b8`;
        mythContext.shadowBlur = 32;
        mythContext.drawImage(portraitImage, (width - portraitWidth) / 2, height - portraitHeight, portraitWidth, portraitHeight);
        mythContext.restore();

        const portraitTint = mythContext.createLinearGradient(0, 0, width, height);
        portraitTint.addColorStop(0, `${lightColor}15`);
        portraitTint.addColorStop(.62, 'rgba(0,0,0,0)');
        portraitTint.addColorStop(1, 'rgba(0,0,0,.22)');
        mythContext.fillStyle = portraitTint;
        mythContext.fillRect(0, 0, width, height);

        if (mythAnswers.gift === 'cloak') {
          mythContext.strokeStyle = '#f1d17a';
          mythContext.lineWidth = 5;
          mythContext.shadowColor = '#f1d17a';
          mythContext.shadowBlur = 18;
          mythContext.beginPath();
          mythContext.moveTo(168, 760);
          mythContext.quadraticCurveTo(450, 660, 732, 760);
          mythContext.quadraticCurveTo(690, 930, 650, 1080);
          mythContext.stroke();
          mythContext.shadowBlur = 0;
        }

        if (mythAnswers.gift === 'horns') {
          mythContext.strokeStyle = '#d9f3ff'; mythContext.lineWidth = 15; mythContext.lineCap = 'round';
          mythContext.beginPath(); mythContext.moveTo(350, 290); mythContext.bezierCurveTo(295, 200, 305, 135, 350, 95); mythContext.stroke();
          mythContext.beginPath(); mythContext.moveTo(550, 290); mythContext.bezierCurveTo(605, 200, 595, 135, 550, 95); mythContext.stroke();
        } else if (mythAnswers.gift === 'crown') {
          mythContext.fillStyle = '#f2ce72';
          mythContext.beginPath(); mythContext.moveTo(335, 270); mythContext.lineTo(350, 160); mythContext.lineTo(410, 230); mythContext.lineTo(450, 125); mythContext.lineTo(490, 230); mythContext.lineTo(550, 160); mythContext.lineTo(565, 270); mythContext.closePath(); mythContext.fill();
        } else if (mythAnswers.gift === 'thunderbolt') {
          mythContext.fillStyle = '#ffe07b';
          mythContext.beginPath(); mythContext.moveTo(175, 510); mythContext.lineTo(275, 510); mythContext.lineTo(225, 635); mythContext.lineTo(300, 635); mythContext.lineTo(155, 865); mythContext.lineTo(195, 680); mythContext.lineTo(120, 680); mythContext.closePath(); mythContext.fill();
        } else if (mythAnswers.gift === 'helm') {
          mythContext.strokeStyle = '#d9e2ec'; mythContext.lineWidth = 24;
          mythContext.beginPath(); mythContext.arc(450, 335, 158, Math.PI * 1.05, Math.PI * 1.95); mythContext.stroke();
          mythContext.fillStyle = '#d9e2ec'; mythContext.fillRect(440, 145, 20, 95);
        } else if (mythAnswers.gift === 'bow') {
          mythContext.strokeStyle = '#f2ce72'; mythContext.lineWidth = 9;
          mythContext.beginPath(); mythContext.moveTo(700, 545); mythContext.quadraticCurveTo(820, 715, 700, 915); mythContext.stroke();
          mythContext.lineWidth = 3; mythContext.beginPath(); mythContext.moveTo(700, 545); mythContext.lineTo(700, 915); mythContext.stroke();
        } else if (mythAnswers.gift === 'sandals') {
          mythContext.font = '600 88px Georgia, serif'; mythContext.fillStyle = '#f4e3b0'; mythContext.fillText('❧', 250, 845); mythContext.fillText('❧', 650, 845);
        } else if (mythAnswers.gift === 'shield') {
          drawMythEllipse(685, 820, 118, 118, '#8f672f', '#f2ce72', 12);
          mythContext.font = '600 92px Georgia, serif'; mythContext.fillStyle = '#f2ce72'; mythContext.fillText('Ω', 685, 820);
        }

        mythContext.textAlign = 'center';
        mythContext.textBaseline = 'middle';
        mythContext.shadowColor = lightColor;
        mythContext.shadowBlur = 18;
        mythContext.fillStyle = lightColor;
        mythContext.font = '600 58px Georgia, "Apple Color Emoji", "Segoe UI Emoji", serif';
        mythContext.fillText(mythAnswers.virtue === 'wisdom' ? '◇' : '✦', 105, 100);

        mythContext.font = '600 70px Georgia, "Apple Color Emoji", "Segoe UI Emoji", serif';
        mythContext.fillStyle = lightColor;
        mythContext.textAlign = 'center';
        mythContext.shadowColor = lightColor;
        mythContext.shadowBlur = 16;
        mythContext.fillText(mythWords.realm[mythAnswers.realm].companion, 785, 980);
        mythContext.shadowBlur = 0;

        const vignette = mythContext.createRadialGradient(450, 500, 350, 450, 500, 700);
        vignette.addColorStop(.55, 'rgba(0,0,0,0)');
        vignette.addColorStop(1, 'rgba(0,0,0,.42)');
        mythContext.fillStyle = vignette;
        mythContext.fillRect(0, 0, width, height);
      }

      mythQuiz.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (mythQuestions.some((question) => !mythAnswers[question.dataset.mythQuestion])) return;

        const seed = ['form', 'light', 'realm', 'gift', 'virtue'].map((key) => mythAnswers[key]).join('').split('').reduce((total, letter) => total + letter.charCodeAt(0), 0);
        const possibleNames = mythNames[mythAnswers.form][mythAnswers.light];
        const name = possibleNames[seed % possibleNames.length];
        const form = mythWords.form[mythAnswers.form];
        const light = mythWords.light[mythAnswers.light];
        const realm = mythWords.realm[mythAnswers.realm];
        const gift = mythWords.gift[mythAnswers.gift];
        const virtue = mythWords.virtue[mythAnswers.virtue];

        mythPortrait.dataset.light = mythAnswers.light;
        document.getElementById('myth-title').textContent = `The ${virtue.title} ${light.title} ${realm.title}`;
        document.getElementById('myth-name').textContent = name;
        document.getElementById('myth-description').textContent = `${name} is ${form.description}, guided by ${light.description}. With ${gift.description}, ${name} explores ${realm.description} and ${virtue.description}.`;
        document.getElementById('myth-powers').replaceChildren(...[form.label, light.power, realm.power, gift.power, virtue.power].map((power) => {
          const item = document.createElement('li');
          item.textContent = power;
          return item;
        }));
        mythCanvas.setAttribute('aria-label', `Portrait of ${name}, ${form.label}`);
        mythReveal.disabled = true;
        mythProgress.textContent = 'Painting your portrait…';
        try {
          await drawMythPortrait(seed);
        } catch (error) {
          mythProgress.textContent = 'The portrait could not be painted. Please try again.';
          mythReveal.disabled = false;
          return;
        }

        mythQuiz.hidden = true;
        mythResult.hidden = false;
      });

      document.getElementById('myth-save').addEventListener('click', () => {
        mythCanvas.toBlob((blob) => {
          if (!blob) return;
          const link = document.createElement('a');
          link.download = `${document.getElementById('myth-name').textContent.toLowerCase()}-myth.png`;
          link.href = URL.createObjectURL(blob);
          link.click();
          setTimeout(() => URL.revokeObjectURL(link.href), 1000);
        }, 'image/png');
      });

      document.getElementById('myth-again').addEventListener('click', () => {
        Object.keys(mythAnswers).forEach((key) => delete mythAnswers[key]);
        mythQuestions.forEach((question) => question.querySelectorAll('[data-myth-answer]').forEach((choice) => {
          choice.classList.remove('is-selected');
          choice.setAttribute('aria-pressed', 'false');
        }));
        lockMythQuestions();
        mythResult.hidden = true;
        mythQuiz.hidden = false;
        updateMythProgress();
        mythQuiz.querySelector('[data-myth-answer]').focus();
      });

      const books = {
        wild: '',
        wrinkle: 'Ask Mom about the strange idea after chapter 5.',
        moon: 'Favorite line saved on the Moonlight board.',
        garden: 'Keep this one close for a slow, quiet afternoon.',
        reach: 'Look for this one on the next library visit.',
        anne: 'This one is next on the reading list.'
      };
      let selectedBook = 'wild';
      const reminderButton = document.getElementById('book-reminder');
      const bookTitleInput = document.getElementById('book-title-input');
      const bookTitles = JSON.parse(localStorage.getItem('dori-book-titles') || '{}');
      const bookshelf = document.querySelector('.bookshelf');
      const shelfEdge = bookshelf.querySelector('.shelf-edge');
      const defaultBookOrder = Object.keys(books);
      let bookOrder = JSON.parse(localStorage.getItem('dori-book-order') || 'null');
      if (!Array.isArray(bookOrder) || bookOrder.length !== defaultBookOrder.length || defaultBookOrder.some((key) => !bookOrder.includes(key))) {
        bookOrder = [...defaultBookOrder];
      }
      const moveBookLeft = document.getElementById('move-book-left');
      const moveBookRight = document.getElementById('move-book-right');

      function renderBookOrder() {
        bookOrder.forEach((key) => bookshelf.insertBefore(document.querySelector(`[data-book="${key}"]`), shelfEdge));
      }

      function saveBookOrder() {
        localStorage.setItem('dori-book-order', JSON.stringify(bookOrder));
        renderBookOrder();
      }

      function updateMoveButtons() {
        const index = bookOrder.indexOf(selectedBook);
        moveBookLeft.disabled = index <= 0;
        moveBookRight.disabled = index >= bookOrder.length - 1;
      }

      function applyBookTitle(key) {
        const book = document.querySelector(`[data-book="${key}"]`);
        const title = (bookTitles[key] || '').trim();
        const label = book.querySelector('.book__label')?.textContent?.trim();
        book.querySelector('.book__title').textContent = title;
        book.setAttribute('aria-label', `${title || 'Untitled book'}${label ? ` · ${label}` : ''}`);
        if (selectedBook === key) document.getElementById('book-title').textContent = title || 'Untitled volume';
      }

      renderBookOrder();
      Object.keys(books).forEach(applyBookTitle);

      function showBook(key) {
        selectedBook = key;
        document.querySelectorAll('[data-book]').forEach((item) => {
          const active = item.dataset.book === key;
          item.classList.toggle('is-selected', active);
          item.setAttribute('aria-pressed', String(active));
        });
        applyBookTitle(key);
        bookTitleInput.value = bookTitles[key] || '';
        const bookCopy = document.getElementById('book-copy');
        bookCopy.textContent = books[key];
        bookCopy.hidden = !books[key];
        const reminders = JSON.parse(localStorage.getItem('dori-book-reminders') || '{}');
        reminderButton.textContent = reminders[key] ? 'Marked for tonight ✓' : 'Mark for tonight';
        reminderButton.classList.toggle('is-marked', Boolean(reminders[key]));
        updateMoveButtons();
      }
      document.querySelectorAll('[data-book]').forEach((book) => {
        book.draggable = true;
        book.addEventListener('click', () => showBook(book.dataset.book));
        book.addEventListener('dragstart', (event) => {
          event.dataTransfer.effectAllowed = 'move';
          event.dataTransfer.setData('text/plain', book.dataset.book);
          book.classList.add('is-dragging');
        });
        book.addEventListener('dragend', () => book.classList.remove('is-dragging'));
        book.addEventListener('dragover', (event) => {
          event.preventDefault();
          event.dataTransfer.dropEffect = 'move';
        });
        book.addEventListener('drop', (event) => {
          event.preventDefault();
          const draggedKey = event.dataTransfer.getData('text/plain');
          const targetKey = book.dataset.book;
          if (!draggedKey || draggedKey === targetKey) return;
          const nextOrder = bookOrder.filter((key) => key !== draggedKey);
          const targetIndex = nextOrder.indexOf(targetKey);
          const targetBox = book.getBoundingClientRect();
          const placeAfter = event.clientX > targetBox.left + targetBox.width / 2;
          nextOrder.splice(targetIndex + (placeAfter ? 1 : 0), 0, draggedKey);
          bookOrder = nextOrder;
          saveBookOrder();
          updateMoveButtons();
        });
      });
      moveBookLeft.addEventListener('click', () => {
        const index = bookOrder.indexOf(selectedBook);
        if (index <= 0) return;
        [bookOrder[index - 1], bookOrder[index]] = [bookOrder[index], bookOrder[index - 1]];
        saveBookOrder();
        updateMoveButtons();
      });
      moveBookRight.addEventListener('click', () => {
        const index = bookOrder.indexOf(selectedBook);
        if (index >= bookOrder.length - 1) return;
        [bookOrder[index], bookOrder[index + 1]] = [bookOrder[index + 1], bookOrder[index]];
        saveBookOrder();
        updateMoveButtons();
      });
      bookTitleInput.addEventListener('input', () => {
        const title = bookTitleInput.value;
        if (title.trim()) bookTitles[selectedBook] = title;
        else delete bookTitles[selectedBook];
        localStorage.setItem('dori-book-titles', JSON.stringify(bookTitles));
        applyBookTitle(selectedBook);
      });
      reminderButton.addEventListener('click', () => {
        const reminders = JSON.parse(localStorage.getItem('dori-book-reminders') || '{}');
        reminders[selectedBook] = !reminders[selectedBook];
        localStorage.setItem('dori-book-reminders', JSON.stringify(reminders));
        showBook(selectedBook);
      });
      showBook('wild');
    </script>
  </body>
</html>
