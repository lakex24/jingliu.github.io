---
import '@fontsource-variable/cormorant/wght.css';
import '@fontsource/ibm-plex-mono/400.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Inner Temple — Dori</title>
    <meta name="description" content="Dori’s quiet inner temple." />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#04070b" />
    <link rel="icon" href="data:," />
    <script is:inline>
      if (sessionStorage.getItem('dori-inner-temple-unlocked') !== 'true') {
        window.location.replace('/#library');
      }
    </script>
  </head>
  <body>
    <main class="inner-temple" aria-labelledby="inner-temple-title">
      <h1 id="inner-temple-title">Inner Temple</h1>
      <a class="inner-temple__return" href="/" aria-label="Return to the home page">
        <span aria-hidden="true">←</span>
        <span>Home</span>
      </a>
    </main>
  </body>
</html>

<style is:global>
  :root { --night: #04070b; --gold: #e7ca7f; --ghost: #bcd4e9; }
  * { box-sizing: border-box; }
  html, body { min-width: 320px; min-height: 100%; margin: 0; background: var(--night); }
  body { color: var(--ghost); font-family: 'Cormorant Variable', 'Cormorant Garamond', Georgia, serif; }
  .inner-temple { min-height: 100svh; position: relative; overflow: hidden; background: radial-gradient(circle at 50% 48%, rgba(34,59,75,.18), transparent 34%), linear-gradient(145deg, #060b12, #020305 72%); }
  .inner-temple::before { content: ''; position: absolute; inset: 0; pointer-events: none; opacity: .26; background: linear-gradient(90deg, transparent 0 49.9%, rgba(231,202,127,.16) 50%, transparent 50.1%), linear-gradient(transparent 0 49.9%, rgba(188,212,233,.08) 50%, transparent 50.1%); }
  #inner-temple-title { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  .inner-temple__return { position: absolute; top: clamp(1rem, 3vw, 2.5rem); left: clamp(1rem, 3vw, 2.5rem); display: inline-flex; align-items: center; gap: .7rem; min-height: 46px; padding: .6rem .9rem; border: 1px solid rgba(231,202,127,.48); border-radius: 999px; background: rgba(4,7,11,.5); color: var(--gold); font-family: 'IBM Plex Mono', ui-monospace, Menlo, monospace; font-size: .62rem; letter-spacing: .15em; text-decoration: none; text-transform: uppercase; backdrop-filter: blur(10px); transition: border-color .2s ease, box-shadow .2s ease, transform .2s ease; }
  .inner-temple__return:hover { border-color: var(--gold); box-shadow: 0 0 22px rgba(231,202,127,.18); transform: translateX(-2px); }
  .inner-temple__return:focus-visible { outline: 2px solid var(--ghost); outline-offset: 4px; }
</style>
