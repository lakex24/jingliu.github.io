---
import Base from '../../layouts/Base.astro';
import Arrow from '../../components/Arrow.astro';

// Public portfolio. Only companies Jing chooses to list appear here; descriptions
// are taken from each company's own site. No private deal data.
const portfolio = [
  {
    name: 'Topmoon',
    url: 'https://www.topmoon.ai/',
    domain: 'topmoon.ai',
    sector: 'Real estate · AI video',
    blurb: 'AI video production for real-estate listings: a Zillow link or property photos become a finished listing reel, with a Topmoon consultant checking quality before delivery.',
  },
];
---
<Base title="Startups" description="Angel investments and notes for founders." section="/startups/" heading="Startups">
  <p slot="intro">A public portfolio of angel investments, and notes for people building things.</p>

  <section class="section vc" id="portfolio">
    <div class="vc__head">
      <h2 class="section__title">Portfolio</h2>
      <span class="mono vc__count">{portfolio.length} {portfolio.length === 1 ? 'company' : 'companies'}</span>
    </div>
    <ol class="ledger">
      {portfolio.map((co, i) => (
        <li class="ledger__row">
          <span class="ledger__idx mono">{String(i + 1).padStart(2, '0')}</span>
          <div class="ledger__main">
            <a class="ledger__name" href={co.url} rel="noopener">{co.name} <Arrow /></a>
            <p class="ledger__blurb">{co.blurb}</p>
          </div>
          <dl class="ledger__meta mono">
            <div><dt>Sector</dt><dd>{co.sector}</dd></div>
            <div><dt>Site</dt><dd><a href={co.url} rel="noopener">{co.domain}</a></dd></div>
          </dl>
        </li>
      ))}
    </ol>
  </section>

  <section class="section vc" id="notes">
    <div class="vc__head">
      <h2 class="section__title">Notes for founders</h2>
      <span class="mono vc__count">0 notes</span>
    </div>
    <ol class="ledger ledger--empty">
      <li class="ledger__row">
        <span class="ledger__idx mono">—</span>
        <div class="ledger__main"><p class="ledger__blurb">Short, practical notes will be filed here as they are written.</p></div>
      </li>
    </ol>
  </section>
</Base>

<style>
  /* Startups: a ledger, denser and more matter-of-fact than the rest of the site. */
  .vc__head { display: flex; align-items: baseline; gap: 1rem; }
  .vc__head .section__title { flex: 1; margin-bottom: 0.75rem; }
  .vc__count { white-space: nowrap; color: var(--ink-mute); }
  .ledger { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--ink); }
  .ledger__row {
    display: grid; grid-template-columns: 3rem minmax(0, 1fr) 15rem; gap: 0.5rem 1.5rem; align-items: start;
    padding: 1.25rem 0.5rem 1.4rem; border-bottom: 1px solid var(--line);
    transition: background-color 0.3s ease;
  }
  .ledger__row:hover { background: var(--paper-deep); }
  .ledger__idx { color: var(--ink-mute); padding-top: 0.55rem; }
  .ledger__name { display: inline-flex; align-items: center; gap: 0.6rem; font-family: var(--font-display); font-size: clamp(1.5rem, 2.4vw, 1.9rem); line-height: 1.1; color: var(--ink); text-decoration: none; }
  .ledger__name :global(.arrow) { width: 1.1em; height: 0.36em; color: var(--violet-deep); }
  .ledger__name:hover { color: var(--violet-deep); }
  .ledger__name:hover :global(.arrow) { transform: translateX(0.35em); }
  .ledger__name:hover :global(.arrow__c) { animation: hud-chevron 0.9s ease-in-out infinite; }
  .ledger__name:hover :global(.arrow__c2) { animation-delay: 0.15s; }
  .ledger__name:hover :global(.arrow__c3) { animation-delay: 0.3s; }
  .ledger__blurb { margin: 0.4rem 0 0; color: var(--ink-soft); max-width: 36rem; }
  .ledger__meta { margin: 0; padding-top: 0.55rem; display: grid; gap: 0.5rem; }
  .ledger__meta div { display: grid; grid-template-columns: 4.5rem 1fr; gap: 0.5rem; }
  .ledger__meta dt { color: var(--ink-mute); }
  .ledger__meta dd { margin: 0; text-transform: none; letter-spacing: 0.04em; font-size: 0.78rem; color: var(--ink); }
  .ledger__meta a { color: var(--violet-deep); text-decoration: none; }
  .ledger__meta a:hover { text-decoration: underline; }
  .ledger--empty .ledger__row { color: var(--ink-mute); }
  .ledger--empty .ledger__row:hover { background: none; }
  @media (max-width: 719px) {
    .ledger__row { grid-template-columns: 2.25rem minmax(0, 1fr); padding-inline: 0; }
    .ledger__meta { grid-column: 2; padding-top: 0; }
  }
</style>
