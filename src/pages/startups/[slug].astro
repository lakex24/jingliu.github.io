---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => !data.draft);
  return notes.map((note) => ({ params: { slug: note.id }, props: { note } }));
}
const { note } = Astro.props;
const { Content } = await render(note);
const lang = note.data.lang;
const dateText = note.data.date.toLocaleDateString(lang === 'zh' ? 'zh-CN' : 'en-US', { year: 'numeric', month: 'long', timeZone: 'UTC' });
---
<Base title={note.data.title} description={note.data.description} section="/startups/" heading="Notes for founders" headingHref="/startups/#notes" lang={lang}>
  <article>
    <header class="article-head">
      <span class="mono">{dateText}</span>
      <h1>{note.data.title}</h1>
      {note.data.aiDraft && <p class="note note--inline">草稿：由 AI 协助起草，待 Jing 修订。</p>}
    </header>
    <div class="prose"><Content /></div>
    <nav class="article-nav" aria-label="Notes">
      <a class="button" href="/startups/#notes">← All notes</a>
    </nav>
  </article>
</Base>
