---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Quote from '../components/Quote.astro';
import Botanicals from '../components/Botanicals.astro';
import { art } from '../data/art';
import { site } from '../data/site';
import startups from '../assets/tiles/startups.jpg';
import career from '../assets/tiles/career.jpg';
import blogs from '../assets/tiles/blogs.jpg';
import goodies from '../assets/tiles/goodies.jpg';

// Tile photos: the raster art variants ship the mockup-style nature shots;
// the default variant falls back to Jing's own 2014 photo-diary shots.
const photos = art?.tiles.startups
  ? {
      '/startups/': { img: art.tiles.startups!, alt: 'A seedling breaking through dark soil in morning light' },
      '/career/': { img: art.tiles.career!, alt: 'A footpath winding through a sunlit pine forest' },
      '/blogs/': { img: art.tiles.blogs!, alt: 'A luna moth resting among leaves and white blossoms' },
      '/goodies/': { img: art.tiles.goodies!, alt: 'Small mushrooms in moss beside an open book' },
    }
  : {
      '/startups/': { img: startups, alt: 'Sunlight breaking through clouds over Lake Zurich' },
      '/career/': { img: career, alt: 'Bone-like stone columns of Casa Batlló, Barcelona' },
      '/blogs/': { img: blogs, alt: 'Birds nesting in the carved walls of the Alhambra' },
      '/goodies/': { img: goodies, alt: 'A plate of fried fish in a plant-filled courtyard café' },
    };
// Tiles follow the nav order in site.ts.
const tiles = site.nav.map((n) => ({ ...n, ...photos[n.href as keyof typeof photos] }));
---
<Base home section="/">
  <Fragment slot="head">
    <script is:inline>
      // Old single-page homepage anchors → new sections (keeps existing deep links working).
      (function () {
        var map = { '#roles': '/career/#roles', '#features': '/career/#features', '#publication': '/career/#publication', '#blogs': '/blogs/', '#contact': '/career/#contact' };
        var to = map[location.hash];
        if (to) location.replace(to);
      })();
    </script>
  </Fragment>

  <section class="hero" aria-label="Welcome">
    <div class="hero__wash"></div>
    <div class="hero__grain"></div>
    <Botanicals />
    <div class="hero__inner">
      <Quote />
    </div>
  </section>

  <nav aria-label="Sections">
    <ul class="tiles">
      {tiles.map((t) => (
        <li>
          <a class="tile" href={t.href}>
            <span class="tile__title">{t.label} <span class="tile__arrow" aria-hidden="true">[ → ]</span></span>
            <span class="tile__tag mono">{t.tagline}</span>
            <div class="tile__img">
              <Picture src={t.img} formats={['avif', 'webp']} widths={[320, 480, 640, 900]} sizes="(min-width: 900px) 25vw, 50vw" alt={t.alt} loading="eager" />
            </div>
          </a>
        </li>
      ))}
    </ul>
  </nav>
</Base>
