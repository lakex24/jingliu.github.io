---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Quote from '../components/Quote.astro';
import Stem from '../components/Stem.astro';
import Fern from '../components/Fern.astro';
import Floor from '../components/Floor.astro';
import { site } from '../data/site';
import startups from '../assets/tiles/startups.jpg';
import career from '../assets/tiles/career.jpg';
import blogs from '../assets/tiles/blogs.jpg';
import goodies from '../assets/tiles/goodies.jpg';

// Tile photos are placeholders taken from Jing's own 2014 photo diary; swap
// for final approved artwork (see docs/EXECUTION-PLAN.md, step 4).
const tiles = [
  { ...site.nav[0], img: startups, alt: 'Sunlight breaking through clouds over Lake Zurich' },
  { ...site.nav[1], img: career, alt: 'Bone-like stone columns of Casa Batlló, Barcelona' },
  { ...site.nav[2], img: blogs, alt: 'Birds nesting in the carved walls of the Alhambra' },
  { ...site.nav[3], img: goodies, alt: 'A plate of fried fish in a plant-filled courtyard café' },
];
---
<Base home section="/">
  <Fragment slot="head">
    <script is:inline>
      // Old single-page homepage anchors → new sections (keeps existing deep links working).
      (function () {
        var map = { '#roles': '/career/#roles', '#features': '/career/#features', '#publication': '/career/#publication', '#blogs': '/blogs/', '#contact': '/career/#contact' };
        var to = map[location.hash];
        if (to) location.replace(to);
      })();
    </script>
  </Fragment>

  <section class="hero" aria-label="Welcome">
    <div class="hero__wash"></div>
    <div class="hero__grain"></div>
    <Stem class="botanical botanical--left" />
    <Fern class="botanical botanical--right" />
    <Floor class="botanical botanical--floor" />
    <div class="hero__inner">
      <Quote />
    </div>
  </section>

  <nav aria-label="Sections">
    <ul class="tiles">
      {tiles.map((t) => (
        <li>
          <a class="tile" href={t.href}>
            <div class="tile__img">
              <Picture src={t.img} formats={['avif', 'webp']} widths={[320, 480, 640, 900]} sizes="(min-width: 900px) 25vw, 50vw" alt={t.alt} loading="eager" />
            </div>
            <span class="tile__title">{t.label} <span class="tile__arrow" aria-hidden="true">[ → ]</span></span>
            <span class="tile__tag mono">{t.tagline}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
</Base>
