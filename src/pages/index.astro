---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Quote from '../components/Quote.astro';
import Botanicals from '../components/Botanicals.astro';
import Arrow from '../components/Arrow.astro';
import { site } from '../data/site';
import { tilePhotos } from '../data/art';

// Tiles follow the nav order in site.ts; photos come from the art variant.
const tiles = site.nav.map((n) => ({ ...n, ...tilePhotos[n.href] }));
---
<Base home section="/">
  <Fragment slot="head">
    <script is:inline>
      // Old single-page homepage anchors → new sections (keeps existing deep links working).
      (function () {
        var map = { '#roles': '/career/#roles', '#features': '/career/#features', '#publication': '/career/#publication', '#blogs': '/blogs/', '#contact': '/career/#contact' };
        var to = map[location.hash];
        if (to) location.replace(to);
        document.addEventListener('astro:page-load', function () { var t = map[location.hash]; if (t) location.replace(t); });
      })();
    </script>
  </Fragment>

  <a class="return-to-dori" href="https://dori-homepage.mind-pixels.com/" aria-label="Back to Dori's site">
    <span aria-hidden="true">←</span> Back to Dori
  </a>

  <section class="hero" aria-label="Welcome">
    <div class="hero__wash"></div>
    <div class="hero__grain"></div>
    <Botanicals />
    <div class="hero__inner">
      <Quote />
    </div>
  </section>

  <nav aria-label="Sections">
    <ul class="tiles">
      {tiles.map((t) => (
        <li>
          <a class="tile" href={t.href}>
            <div class="tile__img">
              <Picture src={t.img} formats={['avif', 'webp']} widths={[320, 480, 640, 900]} sizes="(min-width: 900px) 25vw, 50vw" alt={t.alt} loading="eager" />
            </div>
            <span class="tile__text">
              <span class="tile__title">{t.label} <Arrow class="tile__arrow" /></span>
              <span class="tile__tag mono">{t.tagline}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
</Base>
