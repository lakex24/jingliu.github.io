---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = (d: Date, lang: string) => d.toLocaleDateString(lang === 'zh' ? 'zh-CN' : 'en-US', { year: 'numeric', month: 'long', timeZone: 'UTC' });
---
<Base title="Blogs" description="Writing by Jing Liu — memories, photography, and notes from work." section="/blogs/" heading="Blogs">
  <p slot="intro">Thoughts in the wild — an archive, newest first.</p>
  <ol class="post-list section" reversed>
    {posts.map((p) => (
      <li lang={p.data.lang}>
        <span class="mono">{fmt(p.data.date, p.data.lang)}</span>
        <h2><a href={`/blogs/${p.id}/`}>{p.data.title}</a></h2>
        <p>{p.data.description}</p>
      </li>
    ))}
  </ol>
</Base>
