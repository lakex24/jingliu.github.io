---
// A slender fern frond: the rachis arcs up and curls inward; paired pinnae
// are slender tapered leaflets, longest mid-frond and shrinking to the tip.
// Decorative only — the caller sets aria-hidden.
const W = 220, H = 480;
const rachis = (t: number) => ({
  x: 165 - 120 * t + 70 * t * t,
  y: H - 16 - (H - 70) * t + 30 * t * t,
});
const tangent = (t: number) => {
  const a = rachis(Math.max(0, t - 0.01)), b = rachis(Math.min(1, t + 0.01));
  return Math.atan2(b.y - a.y, b.x - a.x); // radians, screen coords
};
const leaflets: { d: string; tf: string }[] = [];
const N = 24;
for (let i = 2; i <= N; i++) {
  const t = i / N;
  const { x, y } = rachis(t);
  const len = 8 + 60 * Math.sin(Math.PI * Math.min(1, t * 1.15)) * (1 - 0.5 * t);
  const w = len * 0.16;
  const d = `M0,0 C${(len * 0.25).toFixed(1)},${(-w).toFixed(1)} ${(len * 0.7).toFixed(1)},${(-w * 0.9).toFixed(1)} ${len.toFixed(1)},0 C${(len * 0.7).toFixed(1)},${(w * 0.9).toFixed(1)} ${(len * 0.25).toFixed(1)},${w.toFixed(1)} 0,0Z`;
  const base = (tangent(t) * 180) / Math.PI; // direction of growth along the rachis
  const tilt = 62 - 14 * t; // leaflets angle forward toward the tip
  for (const side of [1, -1]) {
    leaflets.push({ d, tf: `translate(${x.toFixed(1)} ${y.toFixed(1)}) rotate(${(base + side * tilt).toFixed(1)})` });
  }
}
const pts = Array.from({ length: 13 }, (_, i) => rachis(i / 12));
const spine = 'M' + pts.map((p) => `${p.x.toFixed(1)},${p.y.toFixed(1)}`).join(' L');
const { class: className } = Astro.props;
---
<svg class={className} viewBox={`0 0 ${W} ${H}`} xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
  <g fill="rgba(124,77,255,0.12)" stroke="currentColor" stroke-width="0.9" stroke-linejoin="round" stroke-opacity="0.7">
    {leaflets.map((l) => <path d={l.d} transform={l.tf} />)}
  </g>
  <path d={spine} fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" stroke-opacity="0.85" />
</svg>
