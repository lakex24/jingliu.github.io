---
import { Image } from 'astro:assets';
import { art } from '../data/art';
import Stem from './Stem.astro';
import Fern from './Fern.astro';
import Floor from './Floor.astro';
// Decorative margins for the home hero. Raster variants (crop/gen) use keyed
// PNGs with alpha; the default is generated SVG line art.
---
{art ? (
  <>
    {art.stem && <Image class="botanical botanical--left botanical--raster" src={art.stem} alt="" widths={[200, 320, 480]} sizes="(min-width: 900px) 240px, 100px" loading="eager" />}
    {art.fern && <Image class="botanical botanical--right botanical--raster" src={art.fern} alt="" widths={[200, 320, 480]} sizes="(min-width: 900px) 220px, 90px" loading="eager" />}
    {art.fox && <Image class="botanical botanical--floor botanical--raster" src={art.fox} alt="" widths={[260, 400, 560]} sizes="(min-width: 900px) 280px, 130px" loading="eager" />}
  </>
) : (
  <>
    <Stem class="botanical botanical--left" />
    <Fern class="botanical botanical--right" />
    <Floor class="botanical botanical--floor" />
  </>
)}
