---
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource-variable/source-serif-4/index.css';
import '@fontsource-variable/source-serif-4/wght-italic.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/400-italic.css';
import '@fontsource/parisienne/400.css';
import '@fontsource-variable/cormorant/wght.css';
import '@fontsource-variable/cormorant/wght-italic.css';
import '@fontsource/vt323/400.css';
import '../styles/global.css';
import { site } from '../data/site';
import Ministry from '../components/Ministry.astro';

interface Props {
  title?: string;
  description?: string;
  /** Path of the current top-level section, e.g. "/career/" */
  section?: string;
  home?: boolean;
  /** Masthead text on inner pages (the section name). Rendered as the page h1 unless headingHref is set. */
  heading?: string;
  /** When set, the masthead heading links there (e.g. an article page linking back to /blogs/). */
  headingHref?: string;
  lang?: string;
  ogImage?: string;
  /** Keep search engines out (hidden pages). */
  noindex?: boolean;
  /** Colour theme for this page; 'dark' switches the tokens (see global.css). */
  theme?: 'light' | 'dark';
}
const { title, description = site.description, section, home = false, heading, headingHref, lang = 'en', ogImage, noindex = false, theme = 'light' } = Astro.props;
const fullTitle = title ? `${title} — ${site.name}` : site.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang={lang} data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} — Blogs`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content={theme === 'dark' ? '#17112a' : '#f4f0fa'} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content={home ? 'website' : 'article'} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    {ogImage && <meta property="og:image" content={new URL(ogImage, Astro.site)} />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="page">
      {home ? (
        <header class="masthead">
          <h1 class="welcome"><span class="welcome__text">{site.welcome}</span></h1>
          <nav class="nav nav--home" aria-label="Primary">
            <ul>
              {site.nav.map((item) => (<li><a href={item.href}>{item.label}</a></li>))}
            </ul>
          </nav>
        </header>
      ) : (
        <header class="masthead masthead--inner">
          <a class="home-link mono" href="/">Home</a>
          <nav class="nav" aria-label="Primary">
            <ul>
              {site.nav.map((item) => (
                <li><a href={item.href} aria-current={section === item.href ? 'page' : undefined}>{item.label}</a></li>
              ))}
            </ul>
          </nav>
        </header>
      )}
      <main id="main" tabindex="-1">
        {!home && (
          <div class="page-title">
            {headingHref
              ? <p class="crumb mono"><a href={headingHref}>{heading}</a></p>
              : <h1>{heading}</h1>}
            <slot name="intro" />
          </div>
        )}
        <slot />
      </main>
      <footer class:list={['footer', 'mono', { 'footer--home': home || section !== '/career/' }]}>
        {home
          ? <span class="footer__home">{site.footerLine} <Ministry /> {new Date().getFullYear()}</span>
          : <>
              <span><a href="/">{site.footerLine}</a> · {new Date().getFullYear()}</span>
              {section === '/career/' && <span><a href={site.social.linkedin} rel="me noopener">LinkedIn</a> · <a href={site.social.scholar} rel="me noopener">Scholar</a> · <a href="/rss.xml">RSS</a></span>}
            </>}
      </footer>
    </div>
  </body>
</html>
